{
  "name": "forum",
  "version": "0.1.7",
  "private": true,
  "description": "Multiplayer documents with Ablo and Tiptap",
  "author": "Ablo",
  "license": "MIT",
  "type": "module",
  "main": "dist/main/index.cjs",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "start": "npm run build && node --env-file-if-exists=.env.local node_modules/electron/cli.js .",
    "server": "tsx src/server/cli.ts",
    "check": "tsc --noEmit",
    "test": "tsx --test tests/*.test.ts",
    "test:electron": "npm run build && node --env-file-if-exists=.env.local tests/electron.mjs",
    "package": "npm run build && electron-forge package",
    "make": "npm run build && electron-forge make",
    "test:integration": "node --env-file-if-exists=.env.local --import tsx --test tests/*.test.ts",
    "test:auth": "npm run build && node --import tsx tests/native-auth.mts",
    "test:site": "node tests/site.mjs",
    "test:browser": "npm run build && node --import tsx tests/browser.mts",
    "test:desktop": "npm run build && node --import tsx tests/desktop.mts",
    "test:agents:live": "node --import tsx tests/hosted-agents-live.mts",
    "test:agents:browser": "npm run build && node --import tsx tests/hosted-agent-browser.mts",
    "test:coverage": "node --import tsx --experimental-test-coverage --test --test-coverage-include=\"src/**/*.ts\" --test-coverage-lines=90 --test-coverage-branches=80 --test-coverage-functions=80 tests/*.test.ts",
    "test:concurrency:live": "node --import tsx tests/concurrency-live.mts",
    "test:members": "npm run build && node --import tsx tests/members-browser.mts",
    "test:pages": "npm run build && node --import tsx tests/paged-editor.mts"
  },
  "devDependencies": {
    "@abloatai/ablo": "0.67.3",
    "@ai-sdk/anthropic": "4.0.106",
    "@better-auth/electron": "1.7.26",
    "@electron-forge/cli": "8.0.1",
    "@electron-forge/maker-zip": "8.0.1",
    "@openai/codex": "0.170.0",
    "@tiptap/core": "3.34.0",
    "@tiptap/extension-placeholder": "3.34.0",
    "@tiptap/pm": "3.34.0",
    "@tiptap/starter-kit": "3.34.0",
    "@types/node": "24.19.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@types/ws": "8.18.2",
    "@vercel/functions": "3.11.3",
    "ai": "7.0.177",
    "better-auth": "1.7.26",
    "electron": "45.3.4",
    "esbuild": "0.28.2",
    "playwright": "1.65.1",
    "prosemirror-collab": "1.3.1",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "streamdown": "2.8.0",
    "tsx": "4.23.15",
    "typescript": "7.0.2",
    "ws": "8.23.0",
    "zod": "4.6.7"
  },
  "config": {
    "forge": "./forge.config.cjs"
  },
  "overrides": {
    "@better-auth/core": "1.7.26",
    "vitest": "5.1.1",
    "vite": "8.3.8"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/Abloatai/forum.git"
  },
  "homepage": "https://forum.abloatai.com",
  "bugs": {
    "url": "https://github.com/Abloatai/forum/issues"
  }
}
